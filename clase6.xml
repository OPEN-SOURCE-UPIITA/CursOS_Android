<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="20dp"
    android:background="@color/ipn"
    tools:context=".MainActivity">

    <!-- TextView de Bienvenida -->
    <TextView
        android:id="@+id/linea1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/bienvenida"
        android:textSize="25sp"
        android:textColor="@color/white"
        android:fontFamily="cursive"
        android:layout_gravity="center_horizontal" />

    <!-- TextView de Nombre -->
    <TextView
        android:id="@+id/linea2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/mi_nombre"
        android:textSize="25sp"
        android:textColor="@color/white"
        android:layout_gravity="center_horizontal" />

    <!-- TextView de Carrera -->
    <TextView
        android:id="@+id/linea3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/mi_carrera"
        android:textSize="25sp"
        android:textColor="@color/white"
        android:layout_gravity="center_horizontal" />

    <!-- EditText -->
    <EditText
        android:id="@+id/etEntradaDato"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="280dp"
        android:layout_marginTop="20dp"
        android:minHeight="48dp"
        android:hint="@string/hint_sensor"
        android:autofillHints="none"
        android:textColorHint="#CCCCCC"
        android:textColor="@color/white"
        android:inputType="numberDecimal"
        android:layout_gravity="center_horizontal" />

    <!-- MaterialSwitch -->
    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/swEstadoSistema"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:minHeight="48dp"
        android:text="@string/estado_sistema"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:layout_gravity="center_horizontal" />

    <!-- SeekBar -->
    <SeekBar
        android:id="@+id/sbControlPotencia"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:minHeight="48dp"
        android:max="100"
        android:progress="50"
        android:layout_gravity="center_horizontal" />

    <!-- Button -->
    <Button
        android:id="@+id/btnEjecutar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:minHeight="48dp"
        android:text="@string/btn_ejecutar"
        android:backgroundTint="@color/white"
        android:textColor="@color/ipn"
        android:layout_gravity="center_horizontal" />

</LinearLayout>
